# ---------------------------------------------------------------- Overprint
# Adaptation: the backlight continuously, the GROUND at the edges of the day.
#
# The file is still called backlight.conf for the sake of the installers that
# reference it. It now configures both halves.
#
#   overprint-appearance                 what is set and what it is doing
#   overprint-appearance ground sensor   pick which source drives the ground
#   overprint-calibrate-ground --start   measure the thresholds sensor needs

# ------------------------------------------------------------------ backlight
BRIGHTNESS=on    # off disables backlight adaptation entirely
BRIGHT_MIN=10    # percent floor, so the panel never goes black
BRIGHT_MAX=100
BRIGHT_KNEE=140  # light reading at which brightness reaches BRIGHT_MAX
MANUAL_HOLD=1800 # if you set brightness yourself, back off for this many seconds

# One camera sample per tick, acted on raw, reproduces the SENSOR'S NOISE as
# screen brightness. Measured over 4.6h of real readings from a room that barely
# changed (27.1-37.4): the old path made 9 panel moves totalling 22.6% of travel
# to follow a genuine span of 7.1%. With these it makes 1 move of 3.1%.
#
# A median rejects a single bad sample outright instead of averaging it in --
# someone crossing the lens used to drop the panel to 15% for a tick; now it does
# not move at all. Cost: a real change takes 2 ticks to register instead of 1.
SMOOTH=3         # samples in the running median; 1 disables smoothing
DEADBAND_REL=6   # deadband as a percent OF THE CURRENT PANEL, not a flat 2%
                 # (a flat 2% is 10% of the panel at 20% and 2% of it at 90%)
DIM_STEP=80      # percent of the step taken when DIMMING; 100 = symmetric.
                 # The median does all the noise rejection by itself, so this
                 # only trades dim-settle time for a gentler fall: 80 settles in
                 # 3 ticks, 100 in 2. Which FEELS better is not something the
                 # tuning data could answer -- it had no real transition in it.

# --------------------------------------------------------------------- ground
# day = paper, slate = a lifted dark for a lit room, night = the deep dark.
# Three separate Omarchy themes; switching keeps the wallpaper's composition.
#
#   off      nothing switches the ground.                        <- the default
#   sensor   the room decides, from the camera. Needs the two thresholds below.
#   solar    the sun decides. Never opens the camera.
#   both     sensor leads; solar covers when the sensor cannot answer.
#   agree    switch only when sensor and solar name the same ground.
GROUND=off

# What a "day room" and a "night room" READ on this camera. There is no sensible
# default: the reading is a 0-255 average behind a locked exposure, so it depends
# on the sensor, the lens, where the machine sits and which way the window faces.
# Blank means uncalibrated, and an uncalibrated sensor decides nothing.
#   overprint-calibrate-ground --start   then use the machine for a day
GROUND_DAY=
GROUND_NIGHT=
GROUND_BAND=6    # hysteresis: how far past a threshold before it counts

# Which ground the sun's two states map to. night+day here means slate is only
# ever reached by the sensor; set GROUND_SOLAR_NIGHT=slate if you would rather
# never see the deep dark from solar alone.
GROUND_SOLAR_DAY=day
GROUND_SOLAR_NIGHT=night

AGREE=2          # consecutive ticks that must want the same ground (10 min each)
DWELL=900        # seconds to sit still after a switch, whatever the readings say

# Where solar gets coordinates. /etc/localtime is always tried FIRST and costs
# no network contact; the whole output of the solar path is one bit -- whether
# the sun is up -- and handing a public IP to a geo vendor for that is a poor
# trade. LOCATE=ip permits one lookup as a fallback if the timezone yields
# nothing. Set LAT/LON yourself and neither is consulted.
LOCATE=off
LAT=
LON=

# ------------------------------------------------------------ daylight floor
# The sensor MIRRORS the room, and on a gloomy winter afternoon that is exactly
# backwards: a dark room at 3pm in December drives the panel to ~20% and the
# ground toward night, when the one surface whose light you control is the
# screen. These clamp how dark it may take you WHILE THE SUN IS UP. After
# sunset they stop applying and the same dark room dims normally.
#
# Both need to know whether the sun is up, so enabling either consults the
# solar fix even when GROUND=off. That is still timezone-derived: no network,
# no coordinates, nothing in the journal.
#
# This is not light therapy and cannot be. A lightbox is ~10,000 lux at the
# eye; a laptop panel is on the order of 100. What this does is stop the
# machine working against you on the days it matters.

DAY_GROUND_FLOOR=slate  # off | night | slate | day -- darkest ground in daylight
                        # (needs GROUND on; inert while GROUND=off)
DAY_BRIGHT_MIN=         # blank = off; panel percent floor while the sun is up

# Record one reading per tick so overprint-calibrate-ground can propose the two
# thresholds. Written 0600 to ~/.local/state/overprint/light-samples.tsv. That
# file is a log of when you were at this machine, which is exactly what the
# journal is kept clear of, so: opt-in, and delete it when you are done.
# ON also keeps the camera sampling even with BRIGHTNESS=off.
GROUND_CALIBRATE=on

# ------------------------------------------------------------------- the lens
# The webcam is sampled once per timer tick (every 10 min) and its LED blinks.
# It is sampled if ANY of these is true: BRIGHTNESS=on, GROUND is sensor/both/
# agree, or GROUND_CALIBRATE=on. If none is, the camera is never opened -- the
# check is at the call site, not somewhere downstream of it.
# To stop the timer outright:
#     systemctl --user disable --now overprint-backlight.timer
#
# touch ~/.config/overprint/hold   to suspend adaptation without disabling it
#
# The journal gets decisions, not measurements: no light readings, no
# coordinates, no sunrise/sunset times. OVERPRINT_DEBUG=1 for the numbers.
