#!/usr/bin/env python3
"""Find the light readings that mean "day room" and "night room" on YOUR camera.

    overprint-calibrate-ground --start   begin recording (one sample per tick)
    overprint-calibrate-ground           report on what has been recorded
    overprint-calibrate-ground --apply   write the proposed thresholds
    overprint-calibrate-ground --stop    stop recording
    overprint-calibrate-ground --forget  delete the recording

It writes GROUND_BAND as well as the two thresholds: the band is hysteresis
measured in reading-units, so the noise this run measures is exactly what sets
it, and a threshold written without its band is only half an answer.

There are no shipped numbers to fall back on and there should not be. The
webcam reports a 0-255 average through a LOCKED exposure, so what a reading
means depends on the sensor, the lens, where the laptop sits and which way the
window faces. A number measured on one machine is noise on another.

Nor can you get it from two button presses in a bright room and a dark one:
that gives the extremes, and the thresholds you need are the two BOUNDARIES
between three grounds. Those live in the middle of the distribution, and where
they fall depends on how the day is actually spent. So this records what the
adapter is already measuring and proposes the splits afterwards.

Run --start, use the machine for a full day including after dark, then come
back. It needs a day's span before it will propose anything.

The recording is an occupancy timeline -- what time the room lit up, what time
you stopped -- which is precisely what the journal is kept clear of. It is
0600, opt-in, and --apply offers to delete it.
"""
import os, sys, time, subprocess, datetime

CFGDIR = os.path.expanduser("~/.config/overprint")
CONF = f"{CFGDIR}/backlight.conf"
SAMPLES = os.path.expanduser("~/.local/state/overprint/light-samples.tsv")

MIN_SAMPLES = 40
MIN_SPAN_H = 18.0        # a full day, so both ends of it are represented


def read_conf():
    d = {}
    try:
        for line in open(CONF):
            line = line.split("#", 1)[0].strip()
            if "=" in line:
                k, v = line.split("=", 1)
                d[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    return d


def set_key(k, v):
    os.makedirs(CFGDIR, exist_ok=True)
    lines, seen = [], False
    try:    lines = open(CONF).read().splitlines()
    except FileNotFoundError: pass
    for i, line in enumerate(lines):
        head = line.split("#", 1)[0]
        if "=" in head and head.split("=", 1)[0].strip() == k:
            lines[i], seen = f"{k}={v}", True
    if not seen:
        lines.append(f"{k}={v}")
    with open(CONF, "w") as f:
        f.write("\n".join(lines) + "\n")


def samples():
    out = []
    try:
        for line in open(SAMPLES):
            try:
                t, v = line.split()
                out.append((int(t), float(v)))
            except ValueError:
                continue
    except FileNotFoundError:
        return []
    return sorted(out)


def kmeans(vals, k):
    """k clusters in one dimension by Lloyd's algorithm from spread-out seeds.
    Returns (centres, groups) sorted by centre, or None if k clusters cannot be
    formed at all. k=3 is night room / lit room / daylight; k=2 is the fallback
    for a room that only has two levels."""
    lo, hi = min(vals), max(vals)
    if hi - lo < 1e-6:
        return None
    cs = [lo + (hi - lo) * i / (k - 1) for i in range(k)]
    groups = None
    for _ in range(60):
        groups = [[] for _ in range(k)]
        for v in vals:
            groups[min(range(k), key=lambda i: abs(v - cs[i]))].append(v)
        if any(not g for g in groups):
            return None
        pairs = sorted((sum(g) / len(g), g) for g in groups)
        new = [c for c, _ in pairs]
        groups = [g for _, g in pairs]
        done = all(abs(a - b) < 1e-9 for a, b in zip(cs, new))
        cs = new
        if done:
            break
    return cs, groups


def pooled_sd(groups):
    """Spread WITHIN the clusters -- the scale of the noise the thresholds have
    to survive."""
    n = sum(len(g) for g in groups)
    if n <= len(groups):
        return 0.0
    ss = 0.0
    for g in groups:
        m = sum(g) / len(g)
        ss += sum((v - m) ** 2 for v in g)
    return (ss / (n - len(groups))) ** 0.5


def profile(rows):
    """Median reading per hour of day. The shape is the point: if it is flat,
    the room never changes and no threshold will help."""
    buckets = {}
    for t, v in rows:
        buckets.setdefault(datetime.datetime.fromtimestamp(t).hour, []).append(v)
    hi = max((sorted(v)[len(v)//2] for v in buckets.values()), default=1.0) or 1.0
    print("  hour  median  (bar scaled to the busiest hour)")
    for h in range(24):
        v = buckets.get(h)
        if not v:
            print(f"  {h:02d}:00      -")
            continue
        med = sorted(v)[len(v) // 2]
        print(f"  {h:02d}:00  {med:6.1f}  {'#' * int(round(med / hi * 40))}"
              f"  ({len(v)} sample{'s' if len(v) != 1 else ''})")


def derive_band(sd):
    """The hysteresis band, measured rather than guessed.

    GROUND_BAND is how far past a threshold a reading must travel before the
    ground changes, so its natural unit is the NOISE of the reading -- which
    this run has just measured. 1.5 pooled SDs is deliberate: it makes
    2 x band equal the 3 x SD noise floor exactly, so the band can never demand
    more separation than the noise already does. It is also the third of three
    brakes (the ground is fed a running median, then AGREE, then DWELL), so it
    does not have to survive a spurious sample on its own.

    Floored at 2.0 because a quiet run -- an empty room, a closed lid, a lens
    staring at its own black floor -- measures a calm the room does not really
    have, and a band of nearly zero would flap on the first real day.

    That floor is also the ONLY reason reachable() has anything to do. While
    band == 1.5 x sd the two constants are balanced and every threshold sits at
    least a band inside the observed range automatically; once the floor takes
    over on a low-noise room the balance breaks and an outer ground really can
    become unenterable. Measured by fuzzing: a ground is marked off in about one
    in nine successful three-way splits. Do not "simplify" reachable() away
    without removing the floor first.
    """
    return max(2.0, round(1.5 * sd, 1))


def separated(cs, groups):
    """Has this split earned it? k-means will ALWAYS return k clusters if you ask
    for k. On a room whose light never really changes it splits the NOISE, and
    the thresholds that come out are a hair apart -- which would flap the ground
    on sensor jitter every tick. So a split has to beat the spread WITHIN the
    clusters: 3 pooled SDs between neighbouring centres.

    That is the ONLY gate, and it is deliberately a question about the room and
    the camera rather than about the config. GROUND_BAND used to sit here as a
    second term, which meant a runtime setting decided whether a day of sampling
    could succeed -- and whenever its shipped default was wider than the room,
    the refusal blamed the camera. The band is now derived from the same sd this
    returns (derive_band) and checked for consequences separately (reachable),
    so no value in the config file can cause or cure a refusal.
    """
    sd = pooled_sd(groups)
    need = 3.0 * sd
    gaps = [b - a for a, b in zip(cs, cs[1:])]
    return min(gaps) >= need, sd, need, gaps


def reachable(which, thr, band, rlo, rhi):
    """Can that outer ground actually be ENTERED, given the readings seen?

    Leaving slate costs the band (see sensor_ground in overprint-adapt), so day
    needs a reading of thr + band and night one of thr - band. If a whole day of
    sampling never saw such a reading, that ground is not sensor-reachable, and
    saying so is better than writing a threshold that can never fire.

    This is what the old band term in the gate was groping at, and it is a
    better test: it asks the observed extremes instead of a proxy for them, and
    its answer is per-ground rather than a blanket refusal -- an unreachable
    outer ground is marked off, and only if BOTH are unreachable does the
    three-way split give way to the two-level path.

    Reachable by construction whenever band == 1.5 x sd; see derive_band for the
    floor that makes this a live check rather than a tautology.
    """
    if which == "day":
        return rhi >= thr + band, thr + band
    return rlo <= thr - band, thr - band


def propose(vals):
    """-> (kind, plan, why, diag). kind is 3, 2 or None.

    Three grounds if the readings support three. Otherwise TWO, because plenty
    of rooms genuinely have two light levels and nothing says all three grounds
    must be sensor-reachable -- refusing outright would throw away a day of
    sampling over a room that is simply not complicated. Only if two will not
    separate either is there nothing to say.

    `plan` carries the thresholds AND the band derived from the same numbers,
    because a threshold without the band that guards it is only half an answer.
    On a refusal, `diag` describes the split that came CLOSEST -- its tightest
    gap and the noise it had to beat. A refusal that cannot say what to change
    is indistinguishable from a broken camera, and this one used to read like
    one.
    """
    rlo, rhi = min(vals), max(vals)
    diag = None

    def closest(k, gaps, sd, need):
        """Keep whichever k came nearest, scored as a fraction of what it needed
        -- gaps from different k are not comparable in absolute terms."""
        nonlocal diag
        short = min(gaps)
        ratio = short / need if need > 0 else 0.0
        if diag is None or ratio > diag["ratio"]:
            diag = {"k": k, "gap": short, "sd": sd, "need": need, "ratio": ratio}

    got3 = kmeans(vals, 3)
    if got3:
        cs, groups = got3
        ok, sd, need, gaps = separated(cs, groups)
        if ok:
            band = derive_band(sd)
            night = round((cs[0] + cs[1]) / 2, 1)
            day = round((cs[1] + cs[2]) / 2, 1)
            n_ok, n_at = reachable("night", night, band, rlo, rhi)
            d_ok, d_at = reachable("day", day, band, rlo, rhi)
            notes = []
            if not n_ok:
                notes.append(f"night would need a reading of {n_at:.1f} and this run "
                             f"never went below {rlo:.1f} -- marked off, so night stays "
                             f"reachable by hand or by solar")
            if not d_ok:
                notes.append(f"day would need a reading of {d_at:.1f} and this run "
                             f"never reached {d_at:.1f} (peak {rhi:.1f}) -- marked off, "
                             f"so the paper ground stays reachable by hand")
            if n_ok or d_ok:
                return 3, {"cs": cs, "sd": sd, "band": band, "notes": notes,
                           "night": night if n_ok else "off",
                           "day": day if d_ok else "off"}, "", None
            why3 = (f"three groups did separate, but with a band of {band:g} neither "
                    f"outer ground is reachable inside the observed {rlo:.1f}-{rhi:.1f}")
        else:
            closest(3, gaps, sd, need)
            why3 = (f"three groups centred at {cs[0]:.1f} / {cs[1]:.1f} / {cs[2]:.1f}, "
                    f"gaps of {gaps[0]:.1f} and {gaps[1]:.1f}, against noise {sd:.1f} "
                    f"-- needs {need:.1f}")
    else:
        why3 = "the readings do not form three groups at all"

    got2 = kmeans(vals, 2)
    if got2:
        cs, groups = got2
        ok, sd, need, gaps = separated(cs, groups)
        if ok:
            return 2, {"boundary": round((cs[0] + cs[1]) / 2, 1), "cs": cs,
                       "sd": sd, "band": derive_band(sd),
                       "range": (rlo, rhi)}, why3, None
        closest(2, gaps, sd, need)
        why2 = (f"two groups centred at {cs[0]:.1f} / {cs[1]:.1f}, gap {gaps[0]:.1f}, "
                f"against noise {sd:.1f} -- needs {need:.1f}")
    else:
        why2 = "nor two"
    return None, None, f"{why3}; and {why2}", diag


PAIRS = {"night-slate": ("night", "slate"), "slate-day": ("slate", "day")}


def report(apply=False, pair=None):
    rows = samples()
    c = read_conf()
    on = c.get("GROUND_CALIBRATE", "off").lower() == "on"
    if not rows:
        print(f"No samples recorded yet. Recording is {'ON' if on else 'OFF'}.")
        if not on:
            print("Start with: overprint-calibrate-ground --start")
        return 1

    vals = [v for _, v in rows]
    span = (rows[-1][0] - rows[0][0]) / 3600.0
    print(f"{len(rows)} samples over {span:.1f} hours, "
          f"recording is {'ON' if on else 'OFF'}")
    print(f"range {min(vals):.1f} - {max(vals):.1f}\n")
    profile(rows)
    print()

    if len(rows) < MIN_SAMPLES or span < MIN_SPAN_H:
        print(f"Not enough yet: {len(rows)}/{MIN_SAMPLES} samples, "
              f"{span:.1f}/{MIN_SPAN_H:.0f} hours.")
        print("Keep going -- it needs the dark end of the day as well as the lit one.")
        return 1

    # No GROUND_BAND is read here on purpose. It is an OUTPUT of this run, not an
    # input to it: see separated() and derive_band().
    kind, payload, why, diag = propose(vals)

    if kind is None:
        print(f"No usable split: {why}.\n")
        if diag:
            print("What blocked it is the spread INSIDE the clusters, which is a fact")
            print("about the room and the camera rather than about any setting:")
            print(f"    closest split   {diag['k']} groups, tightest gap {diag['gap']:.1f}")
            print(f"    required        {diag['need']:.1f}, which is 3 x the "
                  f"{diag['sd']:.1f} of measured noise")
            print()
            print("GROUND_BAND is not involved. It is derived from this same measurement")
            print("when a split succeeds, so no value in the config file can cause this")
            print("refusal or cure it. What can:")
            print()
            print("  - sample a fuller day, if this run missed the brightest or darkest")
            print("    hours. A truncated curve understates the very gap it is judged on.")
            print("  - move the machine or the lens, if the camera faces a wall.")
            print()
            print("Failing those, the room genuinely holds one light level or the camera")
            print("cannot see the change, and the sensor cannot drive the ground here.")
        print("\nIf you would rather not chase it, GROUND=solar needs no sensor at all")
        print("and reaches two of the three grounds (see GROUND_SOLAR_DAY/NIGHT).")
        return 1

    if kind == 3:
        cs, band = payload["cs"], payload["band"]
        night, day = payload["night"], payload["day"]
        print(f"Three light levels found, centred at "
              f"{cs[0]:.1f} / {cs[1]:.1f} / {cs[2]:.1f}:")
        print(f"    GROUND_NIGHT={night}   at or below this -> the night ground")
        print(f"    GROUND_DAY={day}   at or above this -> the day (paper) ground")
        print(f"    between the two   -> slate")
        print(f"    GROUND_BAND={band:g}   how far past a threshold a reading must go;")
        print(f"                    1.5 x the {payload['sd']:.1f} of noise this run "
              f"measured, so the")
        print(f"                    band never asks more separation than the noise does")
        for n in payload["notes"]:
            print(f"    note: {n}")
        if not apply:
            print("\nWrite them with: overprint-calibrate-ground --apply")
            return 0
        return write(c, str(night), str(day), band=band)

    # --- two levels -------------------------------------------------------
    boundary, cs, band = payload["boundary"], payload["cs"], payload["band"]
    print(f"Only TWO light levels here, centred at {cs[0]:.1f} and {cs[1]:.1f},")
    print(f"split at {boundary}. Three would not separate: {why}.")
    print()
    print("That is a usable result, not a failure -- but which two grounds it means")
    print("is NOT something this can work out. The reading is a 0-255 camera average")
    print("with no absolute reference, so a bright cluster at "
          f"{cs[1]:.1f} might be daylight")
    print("through a window or a desk lamp in an otherwise dark room. Only you know.")
    print()
    print("Look at the hours above. Then pick the pair that matches what you saw:")
    print()
    print(f"    --pair night-slate   below {boundary} -> night, above -> slate")
    print( "                         (the bright cluster is LAMPLIGHT; day stays")
    print( "                          reachable by hand or by solar)")
    print(f"    --pair slate-day     below {boundary} -> slate, above -> day")
    print( "                         (the bright cluster is DAYLIGHT; night stays")
    print( "                          reachable by hand or by solar)")
    if not apply:
        print("\nThen: overprint-calibrate-ground --apply --pair <one of the above>")
        return 0
    if pair not in PAIRS:
        print("\n--apply needs --pair here, because the choice above is yours.",
              file=sys.stderr)
        return 2
    lo, hi = PAIRS[pair]
    # `off` means "this ground is not sensor-reachable". The adapter honours it,
    # so a two-ground split needs no special case downstream -- and it reads as
    # what it is in the config, rather than as a sentinel number.
    rlo, rhi = payload["range"]
    ok, at = reachable("night" if lo == "night" else "day", boundary, band, rlo, rhi)
    if not ok:
        print(f"\nThat pair will not fire: {lo if lo != 'slate' else hi} needs a reading "
              f"of {at:.1f} past the", file=sys.stderr)
        print(f"boundary and this run only saw {rlo:.1f}-{rhi:.1f}. Try the other pair.",
              file=sys.stderr)
        return 1
    return write(c, str(boundary) if lo == "night" else "off",
                    str(boundary) if hi == "day" else "off",
                    note=f"{lo} below {boundary}, {hi} above; "
                         f"{'day' if lo == 'night' else 'night'} is not sensor-reachable",
                    band=band)


def write(c, night, day, note=None, band=None):
    set_key("GROUND_NIGHT", night)
    set_key("GROUND_DAY", day)
    was = (c.get("GROUND_BAND") or "").strip()
    if band is not None:
        set_key("GROUND_BAND", f"{band:g}")
    print(f"\nWritten to {CONF}.")
    if band is not None:
        # Say it plainly: this overwrites a setting the user may have chosen, and
        # a threshold written without its band is only half an answer.
        print(f"  GROUND_BAND={band:g}, derived from the noise measured on this run"
              + (f" (was {was})" if was and was != f"{band:g}" else ""))
    if note:
        print(f"  {note}")
    # Read it back rather than asserting. Telling someone adaptation is off when
    # it is on is the same class of lie as a kill-switch that does not switch.
    now = read_conf().get("GROUND", "off").lower()
    if now in ("off", ""):
        print("Ground adaptation is still OFF. Turn it on when you want it:")
        print("    overprint-appearance ground sensor      (the room decides)")
        print("    overprint-appearance ground solar       (the sun decides; no camera)")
        print("    overprint-appearance ground both        (sensor leads, solar covers)")
    elif now == "solar":
        print(f"GROUND={now}, which does not consult the sensor. These thresholds")
        print("take effect if you switch to sensor, both or agree.")
    else:
        print(f"GROUND={now} is already on, so these thresholds are live from the")
        print("next tick.")
    print("\nThe recording is no longer needed and is a log of when you were at")
    print("this machine. Delete it with: overprint-calibrate-ground --forget")
    return 0


def main(argv):
    a = argv[0] if argv else ""
    if a in ("-h", "--help"):
        print(__doc__.strip()); return 0
    if a == "--start":
        set_key("GROUND_CALIBRATE", "on")
        print("Recording one light reading per adapter tick (every 10 minutes).")
        print("This keeps the webcam sampling even if BRIGHTNESS=off.")
        print("Use the machine normally for a full day, then run this again.")
        return 0
    if a == "--stop":
        set_key("GROUND_CALIBRATE", "off")
        print("Recording stopped. The samples so far are kept.")
        return 0
    if a == "--forget":
        try:
            os.remove(SAMPLES); print(f"Deleted {SAMPLES}")
        except FileNotFoundError:
            print("Nothing recorded.")
        return 0
    if a in ("", "--apply", "--report"):
        pair = None
        if "--pair" in argv:
            i = argv.index("--pair")
            pair = argv[i + 1] if i + 1 < len(argv) else None
            if pair not in PAIRS:
                print(f"--pair must be one of: {', '.join(PAIRS)}", file=sys.stderr)
                return 2
        return report(apply=(a == "--apply"), pair=pair)
    print("usage: overprint-calibrate-ground "
          "[--start|--stop|--apply|--forget]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
