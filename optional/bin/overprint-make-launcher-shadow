#!/usr/bin/env bash
#
# Regenerate ~/.local/bin/omarchy-launch-screensaver from Omarchy's packaged
# copy, applying Overprint's two changes.
#
# WHY A SHADOW AT ALL. The idle service hardcodes `omarchy-launch-screensaver`
# (shell/plugins/services/idle/Service.qml) -- there is no config key for the
# screensaver command, so the only interception point is the name itself. The
# service runs the LAUNCHER under `bash -lc`, which sources ~/.bashrc, which
# prepends ~/.local/bin; so a shadow there is reachable. The inner renderer is
# NOT reachable that way: Hyprland spawns the terminal with the session
# environment (/usr/share/omarchy/bin first) and never sources .bashrc, which is
# why the runner below is called by absolute path.
#
# THE TWO CHANGES.
#   1. the inner command becomes Overprint's runner, by absolute path
#   2. font size 18 -> 6. Omarchy's ttfx draws block letters; Overprint's
#      renderer draws a pixel canvas out of half-block cells, so 18 yields a few
#      dozen coarse cells. Font size IS resolution here.
#
# Everything else is upstream's, deliberately: the per-monitor loop, the
# screensaver-off toggle, the `force` argument, terminal-agnosticism, the
# openwindow wait and the focus restore. Re-run this after an Omarchy update --
# the post-update.d hook does it automatically.
#
# Fails loudly rather than writing a shadow that silently runs the wrong thing.
set -euo pipefail

SRC="${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-launch-screensaver"
DST="$HOME/.local/bin/omarchy-launch-screensaver"
# Written into the shadow verbatim, so it expands in the launcher's own shell
# rather than being frozen to whoever ran the generator.
RUNNER_LIT='$HOME/.local/bin/overprint-screensaver-run'
RUNNER="$HOME/.local/bin/overprint-screensaver-run"
FONT_SIZE=6

die() { printf 'overprint-make-launcher-shadow: %s\n' "$1" >&2; exit 1; }

[[ -r $SRC ]]    || die "packaged launcher not readable: $SRC"
[[ -x $RUNNER ]] || die "renderer runner missing or not executable: $RUNNER"

src=$(cat "$SRC")

# Upstream must still look the way we think it does. If a future Omarchy
# rewrites these lines, stop -- do not ship a half-patched launcher.
want_terminals=$(grep -c -- '-e omarchy-screensaver' <<<"$src" || true)
(( want_terminals > 0 )) || die "no '-e omarchy-screensaver' in $SRC -- upstream changed shape, patch by hand"

out=${src//-e omarchy-screensaver/-e \"$RUNNER_LIT\"}
out=${out//--font-size=18/--font-size=$FONT_SIZE}
out=${out//font_size=18/font_size=$FONT_SIZE}

got=$(grep -cF -- "$RUNNER_LIT" <<<"$out" || true)
(( got == want_terminals )) || die "rewrote $got of $want_terminals terminal branches"
grep -q -- '-e omarchy-screensaver' <<<"$out" && die "a terminal branch still calls omarchy-screensaver"
grep -qE 'font.size=18' <<<"$out" && die "a font size of 18 survived the rewrite"

banner="#
# GENERATED by overprint-make-launcher-shadow -- do not edit.
# Derived from Omarchy's omarchy-launch-screensaver (MIT, basecamp/omarchy)
# with two changes: the inner command is Overprint's renderer, by absolute
# path, and the font size is $FONT_SIZE rather than 18. Regenerated by the
# post-update.d hook; run the generator by hand if you skip that.
#"
out=${out/$'#!/bin/bash\n'/$'#!/bin/bash\n'"$banner"$'\n'}

# The rewrite dropped this and mktemp then failed with a bare error under
# `set -e`, bypassing die(). install.sh happens to mkdir -p first, so only a
# standalone run was bitten.
mkdir -p "$(dirname "$DST")"
tmp=$(mktemp "$DST.XXXXXX")
trap 'rm -f "$tmp"' EXIT
printf '%s\n' "$out" >"$tmp"
bash -n "$tmp" || die "generated shadow is not valid bash"
chmod 755 "$tmp"

if [[ -f $DST ]] && cmp -s "$tmp" "$DST"; then
  echo "shadow already current ($want_terminals terminal branches, font size $FONT_SIZE)"
  exit 0
fi
mv -f "$tmp" "$DST"
trap - EXIT
echo "shadow regenerated from $SRC ($want_terminals terminal branches, font size $FONT_SIZE)"
