[Unit]
Description=Weekly re-pull of the current Overprint wallpaper

[Timer]
# Weekly, and deliberately not more often: the point is that the sheet on your
# desk is an impression rather than a fixed image, not that it churns. Persistent
# so a machine that was off on Monday still re-pulls when it comes back.
OnCalendar=Mon 09:00
AccuracySec=1h
Persistent=true

[Install]
WantedBy=timers.target
